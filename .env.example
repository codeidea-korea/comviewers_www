# Local dev: use the current origin and Vite's /api/ proxy to port 8080.
VITE_API_BASE_URL=/
# Optional: call the API directly instead of using the local proxy.
# VITE_API_BASE_URL=http://127.0.0.1:8080

# The API callback must redirect back to this app without putting tokens in the URL.
# API local default: COMVIEWERS_SOCIAL_FRONTEND_REDIRECT_URI=http://127.0.0.1:5301/auth/social/callback

# Optional free-widget name translation. Only coupon/server-room name fields are sent.
# `npm run dev` on 127.0.0.1/localhost:5301 starts the isolated 127.0.0.2:5317 frame too.
# Optional standalone startup (other app tooling): `npm run names:dev`.
# Production: use a dedicated HTTPS site that shares NO authentication cookies.
# Sibling subdomains and same-host/different-port URLs are deliberately rejected.
# Leave unset in production to preserve original names without loading Google.
# VITE_NAME_TRANSLATION_FRAME_URL=https://your-isolated-name-site.example/frame.html
# Sidecar server only (not VITE variables):
# NAME_TRANSLATION_PARENT_ORIGINS=http://127.0.0.1:5301,http://localhost:5301

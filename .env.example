# Only opt in while reviewing inherited publishing popup URLs.
VITE_ENABLE_PUBLISHING_PREVIEWS=false

# Omit to use the local preview repositories. Set this to enable live auth,
# product catalog, organization-scoped cart, and server quote APIs.
# VITE_API_BASE_URL=http://127.0.0.1:8080

# The API callback must redirect back to this app without putting tokens in the URL.
# API local default: COMVIEWERS_SOCIAL_FRONTEND_REDIRECT_URI=http://127.0.0.1:5301/auth/social/callback
